

import os

# Only read the sample paths in the sample_list file from the configuration file（从配置文件中只读取 sample_list 文件中的样本路径）
sample_list_file = config["sample_list"]
with open(sample_list_file) as f:
    #  'sample_name /full/path/to/fastq.gz'
    sample_files = [line.strip() for line in f if line.strip()]

# Build a mapping dictionary from sample names to complete paths（构建样本名称到完整路径的映射字典）
sample_dict = {}
for line in sample_files:
    sample_name, fastq_path = line.split()
    sample_dict[sample_name] = fastq_path

# Read other configuration parameters（读取其它配置参数）
outdir           = config["outdir"]
INDEX_BT         = config["INDEX_BT"]
INDEX_pre_BT     = config["INDEX_pre_BT"]
INDEX            = config["INDEX"]
INDEX_rRNA_BT    = config["INDEX_rRNA_BT"]
MINTplate        = config["MINTplate"]
INDEX_snoRNA_BT  = config["INDEX_snoRNA_BT"]

bowtie           = config["bowtie"]
samtools         = config["samtools"]
cutadapt         = config["cutadapt"]
fastqc           = config["fastqc"]
multiqc          = config["multiqc"]
findadapt        = config["findadapt"]

# 添加 merge_variants 参数读取
merge_variants   = config.get("merge_variants", "yes")

# Explicitly convert _enabled to a Boolean value（显式将 _enabled 转换为布尔值）
if "_enabled" in config:
    if isinstance(config["_enabled"], str):
        if config["_enabled"].lower() == "true":
            config["_enabled"] = True
        elif config["_enabled"].lower() == "false":
            config["_enabled"] = False

# Obtain the list of sample names（获取样本名称列表）
samples = list(sample_dict.keys())

rule all:
    input:
        expand(f"{outdir}/multiqc/multiqc_report.html", sample=samples),
        expand(f"{outdir}/total/result.txt", sample=samples),
        f"{outdir}/clean_done"

if config.get("_enabled", False):
    rule findadapt:
        input:
            lambda wc: sample_dict[wc.sample]
        output:
            per_fq = temp(f"{outdir}/findadapt_output/{{sample}}.per_fq.adapter.txt")
        shell:
            """
            # Create output directory（创建输出目录）
            mkdir -p {outdir}/findadapt_output/
            
            # Run findadapt to generate the output file（运行 findadapt 生成输出文件）
            cd {outdir}/findadapt_output/ && ({findadapt} {input} || touch {wildcards.sample}.per_fq.adapter.txt)
            
            # If the output file is empty, create an empty file to avoid snakemake reporting errors（如果输出文件为空，创建一个空文件以避免snakemake报错）
            if [ ! -s {wildcards.sample}.per_fq.adapter.txt ]; then
                touch {wildcards.sample}.per_fq.adapter.txt
            fi
            """

    rule :
        input:
            fastq = lambda wc: sample_dict[wc.sample],
            per_fq = f"{outdir}/findadapt_output/{{sample}}.per_fq.adapter.txt"
        output:
            temp(f"{outdir}/fix_fastq/{{sample}}.fastq.gz")
        shell:
            """
            # Create output directory（创建输出目录）
            mkdir -p {outdir}/fix_fastq/
            
            # Extract the seq columns from the per_fq adapter file and only accept valid DNA sequences（从 per_fq adapter 文件中提取 seq 列，只接受有效的 DNA 序列）
            if [ -f {input.per_fq} ]; then
                found_seq=$(awk -F'\\t' '{{if($6 ~ /^[ACGT]+$/) print toupper($6)}}' {input.per_fq} | head -n1)
                
                if [ ! -z "$found_seq" ]; then
                    # Use the found adapter sequence（使用找到的 adapter 序列）
                    {} -j 8 --max-n 0 -m 10 -M 50 -a $found_seq -o {output} {input.fastq} || \
                    # If it fails, use the default adapter（如果失败，使用默认 adapter）
                    {} -j 8 --max-n 0 -m 10 -M 50 -a AGATCGGAAGAG -a TGGAATTCTCGG -a GATCGTCGGACT -a CTGTCTCTTATA -o {output} {input.fastq} || \
                    cp {input.fastq} {output}
                else
                    # Use the default adapter（使用默认 adapter）
                    {} -j 8 --max-n 0 -m 10 -M 50 -a AGATCGGAAGAG -a TGGAATTCTCGG -a GATCGTCGGACT -a CTGTCTCTTATA -o {output} {input.fastq} || \
                    cp {input.fastq} {output}
                fi
            else
                # If the per_fq file does not exist, use the default adapter（如果 per_fq 文件不存在，使用默认 adapter）
                {cutadapt} -j 8 --max-n 0 -m 10 -M 50 -a AGATCGGAAGAG -a TGGAATTCTCGG -a GATCGTCGGACT -a CTGTCTCTTATA -o {output} {input.fastq} || \
                cp {input.fastq} {output}
            fi
            """
else:
    rule cutadapt:
        input:
            lambda wc: sample_dict[wc.sample]
        output:
            temp(f"{outdir}/fix_fastq/{{sample}}.fastq.gz")
        shell:
            """
            # When cutadapt_enabled is False, directly copy or soft link the original FASTQ file to the output path of cutadapt（当 cutadapt_enabled 为 False 时，直接将原始 FASTQ 文件复制或软链接到 cutadapt 的输出路径）
            mkdir -p {outdir}/fix_fastq/
            ln -sf {input} {output}
            """

rule fastQC:
    input:
        lambda wc: f"{outdir}/fix_fastq/{wc.sample}.fastq.gz" if config.get("cutadapt_enabled", False) else sample_dict[wc.sample]
    output:
        html = f"{outdir}/html_fastq/{{sample}}_fastqc.html",
        zip = f"{outdir}/html_fastq/{{sample}}_fastqc.zip"
    shell:
        "mkdir -p {outdir}/html_fastq/ && {fastqc} -o {outdir}/html_fastq/ {input}"

rule multiQC:
    input:
        expand(f"{outdir}/html_fastq/{{sample}}_fastqc.html", sample=samples),
        expand(f"{outdir}/html_fastq/{{sample}}_fastqc.zip", sample=samples)
    output:
        f"{outdir}/multiqc/multiqc_report.html"
    shell:
        "{multiqc} -o {outdir}/multiqc {outdir}/html_fastq/"

